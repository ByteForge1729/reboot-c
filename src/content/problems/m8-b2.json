  "hints": [
    "append: malloc a node with `next = NULL`. If the list is empty it **is** the new head; otherwise walk to the node whose `next` is NULL and hang it there.",
    "reverse needs three pointers: `prev` (starts NULL), `cur` (starts at head) and `next`. Each step: remember `cur->next`, point `cur->next` back at `prev`, then step both forward.",
    "When `cur` becomes NULL, `prev` is the old last node: that's the new head. An empty list just returns NULL straight away, which the same loop already does."
  ],
  "solution": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct Node {\n    int value;\n    struct Node *next;\n} Node;\n\nNode *append(Node *head, int value) {\n    Node *n = malloc(sizeof(Node));\n    if (n == NULL) exit(1);\n    n->value = value;\n    n->next = NULL;\n    if (head == NULL) return n;\n    Node *p = head;\n    while (p->next != NULL) p = p->next;\n    p->next = n;\n    return head;\n}\n\nNode *reverse(Node *head) {\n    Node *prev = NULL, *cur = head;\n    while (cur != NULL) {\n        Node *next = cur->next;\n        cur->next = prev;\n        prev = cur;\n        cur = next;\n    }\n    return prev;\n}\n\nvoid print_list(Node *head) {\n    for (Node *p = head; p != NULL; p = p->next) printf(\"%d -> \", p->value);\n    printf(\"NULL\\n\");\n}\n\nvoid free_list(Node *head) {\n    while (head != NULL) {\n        Node *next = head->next;\n        free(head);\n        head = next;\n    }\n}\n\nint main(void) {\n    int n;\n    scanf(\"%d\", &n);\n    Node *head = NULL;\n    for (int i = 0; i < n; i++) {\n        int v;\n        scanf(\"%d\", &v);\n        head = append(head, v);\n    }\n    head = reverse(head);\n    print_list(head);\n    free_list(head);\n    return 0;\n}\n"
}
